// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CLIENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum UserStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum RoomKey {
  ROOM1
  ROOM2
  ROOM3
  ROOM4
  WORKSHOP
  ROOM1_2
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
}

/// מסלול הפעילות של חלון שעות (לוח שעות משותף לכל החדרים)
enum ActivityType {
  BOYS
  GIRLS
}

enum BookingSource {
  WEB
  IVR
  ADMIN
}

model User {
  id           String        @id @default(cuid())
  name         String
  firstName    String?
  lastName     String?
  email        String?       @unique
  phone        String?       @unique
  idNumber     String?       @unique
  gender       Gender?
  /// לעולם לא נשמרים מספר כרטיס מלא או CVV — רק 4 ספרות אחרונות ותוקף (MM/YY)
  cardLast4    String?
  cardExpiry   String?
  passwordHash String
  /// סיסמה זמנית שהוגדרה ע"י מנהל — המשתמש חייב להחליף אותה בכניסה הראשונה
  mustChangePassword Boolean   @default(false)
  role        Role          @default(CLIENT)
  status       UserStatus    @default(PENDING)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Room {
  id           String        @id @default(cuid())
  key          RoomKey       @unique
  name         String
  description  String?
  isCombo      Boolean       @default(false)
  active       Boolean       @default(true)
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId    String
  room      Room              @relation(fields: [roomId], references: [id], onDelete: Restrict)
  startTime DateTime
  endTime   DateTime
  status    AppointmentStatus @default(CONFIRMED)
  source    BookingSource     @default(WEB)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([roomId, startTime, endTime])
  @@index([userId])
}

/// חלון שעות פעילות. שורה עם weekday = ברירת מחדל שבועית; שורה עם date (YYYY-MM-DD) = חריג שדורס את
/// כל ברירת המחדל של אותו תאריך. closed = יום סגור. השעות משותפות לכל החדרים; activity = מסלול הפעילות בחלון.
model OpeningWindow {
  id           String       @id @default(cuid())
  weekday      Int?
  date         String?
  startMinutes Int
  endMinutes   Int
  closed       Boolean      @default(false)
  activity     ActivityType @default(GIRLS) // לא רלוונטי ליום סגור (closed)
  note         String?
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([active, weekday])
  @@index([active, date])
}
