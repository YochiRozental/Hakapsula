# תבנית משתני סביבה לתשלומים. אין כאן ערכים אמיתיים. העתיקו ל-.env והשלימו מקומית.
# ברירת מחדל: בלי PAYMENT_PROVIDER אין תשלומים כלל.

# none | mock | payme (payme עדיין לא ממומש; יופעל רק לאחר אימות התיעוד הרשמי)
PAYMENT_PROVIDER=none

# sandbox = בדיקות; live = סליקה אמיתית. חובה להצהיר במפורש (לא נגזר מ-NODE_ENV)
PAYMENT_ENVIRONMENT=sandbox

# ספק ה-Mock עולה רק אם כל אלה מתקיימים: PAYMENT_PROVIDER=mock, PAYMENT_ENVIRONMENT=sandbox,
# PAYMENT_MOCK_ENABLED=true, NODE_ENV != production, ו-DATABASE_URL מצביע למסד מקומי (localhost/127.0.0.1).
# לעולם לא להגדיר באתר החי.
PAYMENT_MOCK_ENABLED=false

# סוד לחתימת webhook (לפחות 16 תווים אקראיים). ל-Mock בלבד בשלב זה
PAYMENT_WEBHOOK_SECRET=

# שמורים להמשך. השמות יקבעו סופית רק לאחר אימות התיעוד הרשמי של הספקים:
#   - PAYME: סליקה, טוקנים, חיובים, החזרים
#   - פינבוט: הפקת מסמכים חשבונאיים בלבד (לא סליקה)

# בדיקות אינטגרציה של תשלומים והחזקות (npm test): מסד מקומי בלבד ששמו מסתיים ב-_test. בלי זה הבדיקות מדולגות.
# PAYMENTS_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_payments_test
# שער הגדרת הקוד הטלפוני באתר (עמוד /profile/ivr-pin ונתיב /api/profile/ivr-pin). סגור כברירת מחדל; לפתיחה: true.
# לפתוח רק אחרי שהמיגרציה ivr_pin_and_throttle הוחלה בסביבה
IVR_PIN_SETUP_ENABLED=false

# תשלום בטלפון (IVR): סגור כברירת מחדל; כשסגור ה-IVR פועל בדיוק כמו קודם (הזמנה מאושרת מיד, בלי תשלום).
# פעיל רק יחד עם ספק תשלום תקף (כיום Mock בסביבת sandbox מקומית, ראו PAYMENT_*), ורק אם הפאנל של ימות המשיח שולח POST
IVR_PAYMENTS_ENABLED=false

# שמירת כרטיס מדומה באתר (בדיקות בלבד): סגור כברירת מחדל; פעיל רק מול ספק Mock בסביבת sandbox. אינו מקבל פרטי כרטיס
MOCK_SAVED_CARD_ENABLED=false

# בדיקות שירותי הכרטיס השמור וההרשאה החד-פעמית, ובדיקות זרימת התשלום בטלפון (npm test): מסדים מקומיים נפרדים (_test)
# SAVEDCARD_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_savedcard_test
# IVRPAY_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_ivrpay_test

# בדיקות הקוד הטלפוני והגבלת הניסיונות (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# PIN_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_pin_test

# בדיקות הזרימה האמיתית של ה-IVR בשתי השיטות GET/POST (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# IVR_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_ivr_test

# בדיקות חבילות ויתרות (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test (הקבצים רצים במקביל ולכן לא חולקים מסד)
# PACKAGES_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_packages_test

# משמרות קבועות וחיוב חודשי: סגור כברירת מחדל. כשסגור אין עמוד משמרות, אין יצירה, אין חיוב חודשי וה-Cron העסקי אינו פועל.
# פעיל רק יחד עם ספק תשלום תקף (כיום Mock בסביבת sandbox מקומית); בכל סביבה חיה נשאר false
SHIFTS_ENABLED=false

# סוד לנתיב ה-Cron (POST /api/cron/shift-billing, Authorization: Bearer ...). בלי סוד הנתיב מחזיר 404
CRON_SECRET=

# בדיקות משמרות (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# SHIFTS_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_shifts_test

# ניהול כספי למנהל (שלב H): סגור כברירת מחדל. כשסגור אין מסכי ניהול כספי, אין נתיבי API חדשים ואין פעולות כספיות חדשות.
# פעיל רק יחד עם ספק תשלום תקף (כיום Mock בסביבת sandbox מקומית); בכל סביבה חיה נשאר false
FINANCE_ADMIN_ENABLED=false

# בדיקות הניהול הכספי (npm test): מסד מקומי נפרד ששמו מסתיים ב-_test
# FINANCE_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5433/clinics_finance_test
